<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Exists only to paint the window before Compose starts. The colour is the iOS
      LaunchBackground colorset (white / #101113), so the system's first frame matches the one
      Compose draws rather than flashing a different background on launch.
    -->
    <style name="Theme.Ondas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
