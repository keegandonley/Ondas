<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared ahead of the code that needs it. No networking exists in the app yet; the only
      network use PLANNED is the optional OTLP telemetry exporter (spec #90), which will be
      off by default and triple-gated (enabled toggle AND a valid HTTPS endpoint AND a bearer
      key). Chat inference is on-device and needs no permission at all.

      So this permission has exactly one justification, and if spec #90 is ever cut or the
      telemetry feature removed, the permission goes with it rather than lingering as an
      unexplained capability.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ondas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ondas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
