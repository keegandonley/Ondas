<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac Catalyst entitlements = the iOS ones PLUS the menu-bar quick-chat capabilities: the
     team-scoped App Group (shared SwiftData store + settings with the macOS agent; team-scoped so
     macOS doesn't show the "access data from other apps" prompt) and the shared keychain group (so
     the agent reads the telemetry key). Selected via CODE_SIGN_ENTITLEMENTS + $(IS_MACCATALYST). -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(ONDAS_ICLOUD_CONTAINER_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(ONDAS_UBIQUITY_KVSTORE_IDENTIFIER)</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ONDAS_MAC_APP_GROUP_IDENTIFIER)</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(ONDAS_KEYCHAIN_ACCESS_GROUP)</string>
	</array>
</dict>
</plist>
